# Copy to .env, then replace every CHANGE_ME value before starting.
POSTGRES_DB=rallyx
POSTGRES_USER=rallyx
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
HTTP_PORT=8080
HTTP_BIND=127.0.0.1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
SESSION_SECRET=CHANGE_ME_RANDOM_64_CHARACTER_SECRET
CONNECTIVITY_TOKEN=CHANGE_ME_SEPARATE_RANDOM_64_CHARACTER_SERVICE_TOKEN
NODE_RED_CREDENTIAL_SECRET=CHANGE_ME_NODE_RED_SECRET
TZ=Asia/Ho_Chi_Minh
DEMO_SEED=true
# Optional Node-RED engineering producer. Keep disabled when connectivity owns simulator devices.
SIMULATOR_ENABLED=false
SIMULATOR_SITE_ID=demo-site
SIMULATOR_MOTOR_ASSET_ID=demo-motor
SIMULATOR_SENSOR_ASSET_ID=demo-sensor
SIMULATOR_MOTOR_DEVICE_ID=demo-motor-device
SIMULATOR_SENSOR_DEVICE_ID=demo-sensor-device
RALLYX_VERSION=0.1.0
